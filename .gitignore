# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Build outputs
dist/
*/dist/
build/
*/build/
.angular/

# CDK
cdk.out/
cdk.out*/
aws/cdk.out/
aws/cdk.out*/
aws/dist-deploy/
aws/scripts/__pycache__/
aws/cdk-outputs.json

# Lambda build output & deployment artifacts
aws/lambda/api/dist/
aws/lambda/api/lambda.zip
aws/lambda/**/*.zip
aws/*.zip

# Shared compiled output (tsc artifacts — source of truth is .ts files)
shared/**/*.js
shared/**/*.d.ts

# Environment files
.env
.env.local
.env.*.local
*.env
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db
desktop.ini
# Cygwin/MSYS crash dumps. Git Bash drops these wherever it happened to be when a
# child process died, so they appear at the repo root and inside subfolders alike.
**/bash.exe.stackdump
*.stackdump

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
deploy.log

# Testing
coverage/
.nyc_output/

# Playwright
frontend/e2e/.auth/
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# Temporary files
*.tmp
*.temp
.cache/

# Data files (keep structure, ignore content with real data)
data/*.json
!data/.gitkeep

# Backup files
*.backup
*.bak

# Angular
.angular/cache/
frontend/.angular/



# Compiled output
**/*.js.map
**/*.d.ts.map

# Build output of a stray root-level electron build (not source).
/electron/

# Claude Code local runtime state: a session id + PID rewritten every session,
# so tracking it means a dirty tree and a noise commit on every run.
.claude/scheduled_tasks.lock
