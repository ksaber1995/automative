# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#
# The local server (server/index.js) uses these AWS access keys to call the
# Aurora RDS Data API directly — no deployed API endpoint involved.
# ─────────────────────────────────────────────────────────────────────────────

# Credentials — pick ONE of the two options below. The identity must be allowed
# to call rds-data:ExecuteStatement and secretsmanager:GetSecretValue.
#
# Option A (recommended): reuse a named profile from ~/.aws/credentials.
#   Your secret key stays in ~/.aws and is never copied here.
AWS_PROFILE=personal
#
# Option B: paste explicit access keys instead (leave AWS_PROFILE blank if you do).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Aurora + Data API live in eu-west-1.
AWS_REGION=eu-west-1

# ── Pick ONE environment (dev shown). Get these from CloudFormation outputs:
#   aws cloudformation describe-stacks --stack-name AutomateMagicStack-dev \
#     --query "Stacks[0].Outputs" --region eu-west-1 --profile personal
# Look for: DatabaseClusterArn, DatabaseSecretArn, DatabaseName.
#
# DEV  stack: AutomateMagicStack-dev   (DatabaseName = automative)
# PROD stack: AutomateMagicStack-prod  (DatabaseName = automative_prod)

DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=automative

# Local server port (Angular dev server proxies /api here).
PORT=3001
